yarn.fake.nodemanager.rack=	/default-rack
yarn.fake.nodemanger.rpc.port.begin=12000
yarn.fake.nodemanger.http.port.begin=22000
yarn.fake.nodemanger.count=15
yarn.fake.threadpool.size=15
yarn.fake.job.token-servers=hdfs://hadoop01:8888
yarn.fake.job.parallel=10
yarn.fake.job.duration=10000
yarn.fake.job.container.nums=9
yarn.fake.job.container.vcore=1
yarn.fake.job.container.memory-mb=4096
yarn.fake.job.update.threadpool.size=300
yarn.fake.job.cycle.times=1000
yarn.fake.job.queue=default

# 监控配置
yarn.monitor.enabled=true
yarn.monitor.http.port=28080
yarn.monitor.collect.interval=5000

# SLSMetrics 采集与 Web 仪表盘配置
yarn.metrics.collect.interval=5000
yarn.metrics.store.size=3600
yarn.metrics.web.port=28081
yarn.metrics.server.url=http://hadoop01:8088/jmx?qry=Hadoop:*
yarn.metrics.nm.collect.enabled=false
yarn.metrics.nm.url=http://localhost:28080

# SLSMetrics 数据库配置（SQLite）
yarn.metrics.db.path=target/metrics/metrics.db
yarn.metrics.db.batch.size=10
yarn.metrics.db.retention.days=7
yarn.metrics.db.cleanup.interval=3600000